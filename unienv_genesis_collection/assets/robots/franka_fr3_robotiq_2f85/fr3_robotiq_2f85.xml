    <general class="2f85" name="g_fingers_actuator" tendon="g_split" forcerange="-5 5"
             ctrlrange="0 255" gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>

  <!-- ======================================================================
       TENDONS
       ====================================================================== -->
  <tendon>
    <!-- Couples both driver joints symmetrically -->
    <fixed name="g_split">
      <joint joint="g_right_driver_joint" coef="0.485"/>
      <joint joint="g_left_driver_joint"  coef="0.485"/>
    </fixed>
  </tendon>

