<mujoco model="fr3_robotiq_2f85">
  <!--
    Franka Research 3 (FR3) arm + Robotiq 2F-85 v4 gripper.

    MJCF sources (Apache 2.0):
      Arm:     https://github.com/google-deepmind/mujoco_menagerie/tree/main/franka_fr3
      Gripper: https://github.com/google-deepmind/mujoco_menagerie/tree/main/robotiq_2f85_v4

    Mesh files are referenced relative to this XML:
      FR3 arm meshes     → ../franka_fr3/assets/
      Robotiq 2F-85 meshes → ../tianji_marvin/robotiq_assets/

    DOF summary:
      Arm:     7 revolute joints  (fr3_joint1 .. fr3_joint7)
      Gripper: 6 joints (1 actuated DOF via tendon)
      Total: 13 joints, 8 actuated DOF
  -->

  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <!-- ===== FR3 arm defaults ===== -->
    <default class="fr3">
      <!-- Overwritten in joints 5, 6, and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <position inheritrange="1"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <!-- ===== Robotiq 2F-85 defaults (from 2f85.xml) ===== -->
    <default class="2f85">
      <general biastype="affine"/>
      <joint axis="0 0 1"/>
      <default class="robotiq_driver">
        <joint range="0 0.9" armature="0.005" damping="0.1"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_follower">
        <joint range="-0.872664 0.9" armature="0.001"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_spring_link">
        <joint range="-0.29670597283 0.9" armature="0.001"
               stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="robotiq_coupler">
        <joint range="-1.57 0" armature="0.001"
               solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="robotiq_black"/>
      </default>
      <default class="robotiq_collision">
        <geom type="mesh" group="3"/>
        <default class="robotiq_pad_box1">
          <geom mass="1e-6" type="box" pos="0.043258 0 0.12" size="0.002 0.011 0.009375"
                friction="0.7" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
                rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="robotiq_pad_box2">
          <geom mass="1e-6" type="box" pos="0.043258 0 0.13875" size="0.002 0.011 0.009375"
                friction="0.6" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"
                rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

